    .results-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .results-more :global(.results-more__button) {
      width: auto;
    }
  }

  /* The sheet never exists at or above the desktop breakpoint (§17.1:635). */
  @media (min-width: 768px) {
    .sheet,
    .sheet-scrim {
      display: none !important;
    }
  }
</style>
