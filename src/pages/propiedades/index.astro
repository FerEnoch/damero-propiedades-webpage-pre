    /* §17.1:628 — a surface panel, hairline border, no shadow. Not a card. */
    .filter-bar {
      padding: var(--space-6);
      border: 1px solid var(--color-border-decorative);
      border-radius: var(--radius-sm);
      background-color: var(--color-bg-surface);
    }

    .filter-bar :global(.filter-bar__clear) {
