---
/**
 * FilterSelect — docs/DESIGN.md §6 (Filter input, Select).
 *
 * Same field chrome as FilterTextInput (label above, 44px control, sage
 * border on the surface panel, §6:308 invalid state). The native arrow is
 * suppressed and replaced by a custom chevron — inline SVG, `currentColor`
 * (§6:304), decorative and `aria-hidden`.
 */
interface SelectOption {
  value: string;
  label: string;
}

interface Props {
  id: string;
  label: string;
  name?: string;
  options: SelectOption[];
  value?: string;
  /** Validation message; renders the §6:308 invalid state when present. */
  error?: string;
  /** Filter identity for the client-side wiring. */
  filterKey?: string;
  class?: string;
}

const {
  id,
  label,
  name = id,
  options,
  value,
  error,
  filterKey,
  class: className,
} = Astro.props;

const errorId = `${id}-error`;
---

<div class:list={['filter-field', className]}>
  <label class="filter-field__label" for={id}>{label}</label>
  <div class="filter-field__select-wrap">
    <select
      class="filter-field__control"
      id={id}
      name={name}
      data-filter-key={filterKey}
      aria-invalid={error ? 'true' : undefined}
      aria-describedby={error ? errorId : undefined}
    >
      {
        options.map((option) => (
          <option value={option.value} selected={option.value === value}>
            {option.label}
          </option>
        ))
      }
    </select>
    <svg
      class="filter-field__chevron"
      viewBox="0 0 16 16"
      width="16"
      height="16"
      aria-hidden="true"
      focusable="false"
    >
      <path
        d="M4 6L8 10L12 6"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </div>
  {
    error && (
      <p class="filter-field__error" id={errorId}>
        <span class="filter-field__error-prefix">REVISAR</span> {error}
      </p>
    )
  }
</div>

<style>
  .filter-field__label {
    display: block;
    margin-bottom: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-label-sm);
    font-weight: 500;
    line-height: var(--leading-label-sm);
    letter-spacing: var(--tracking-label-sm);
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .filter-field__select-wrap {
    position: relative;
  }

  .filter-field__control {
    display: block;
    width: 100%;
    height: 44px;
    padding-inline: var(--space-3) var(--space-10);
    border: 1px solid var(--color-border-interactive);
    border-radius: var(--radius-sm);
    background-color: var(--color-bg-surface);
    font-family: var(--font-sans);
    font-size: var(--text-body-md);
    line-height: var(--leading-body-md);
    color: var(--color-text-primary);
    appearance: none;
    -webkit-appearance: none;
  }

  .filter-field__chevron {
    position: absolute;
    top: 50%;
    right: var(--space-3);
    transform: translateY(-50%);
    color: var(--color-text-secondary);
    pointer-events: none;
  }

  /* §6:308 — invalid: forest-ink border, never red. */
  .filter-field__control[aria-invalid='true'] {
    border-color: var(--color-text-primary);
  }

  .filter-field__error {
    margin: var(--space-2) 0 0;
    font-size: var(--text-body-sm);
    line-height: var(--leading-body-sm);
    color: var(--color-text-primary);
  }

  .filter-field__error-prefix {
    font-family: var(--font-mono);
    font-size: var(--text-label-sm);
    font-weight: 500;
    line-height: var(--leading-label-sm);
    letter-spacing: var(--tracking-label-sm);
    text-transform: uppercase;
  }
</style>
