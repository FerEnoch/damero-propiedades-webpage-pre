---
/**
 * FilterTextInput — docs/DESIGN.md §6 (Filter input).
 *
 * Label above the control in `--text-label-sm` mono uppercase,
 * `--color-text-secondary` — never a floating label. The control is 44px
 * tall at every breakpoint (§12), `--color-bg-surface`, `1px solid
 * --color-border-interactive`, `--radius-sm`, inline padding `--space-3`,
 * `--text-body-md` in `--color-text-primary`. Sage borders are valid here
 * because the filter panel is a `surface` (§2: 3.42:1).
 *
 * Invalid state (§6:308): no red. The message renders below the control in
 * `--text-body-sm` / `--color-text-primary` with a mono `REVISAR` prefix,
 * and the control's border switches to forest-ink (text-primary alias).
 * The focus ring is the global `2px --color-focus-ring` with 2px offset.
 */
interface Props {
  id: string;
  label: string;
  name?: string;
  type?: 'text' | 'search';
  placeholder?: string;
  value?: string;
  /** Validation message; renders the §6:308 invalid state when present. */
  error?: string;
  /** Filter identity for the client-side wiring. */
  filterKey?: string;
  class?: string;
}

const {
  id,
  label,
  name = id,
  type = 'text',
  placeholder,
  value,
  error,
  filterKey,
  class: className,
} = Astro.props;

const errorId = `${id}-error`;
---

<div class:list={['filter-field', className]}>
  <label class="filter-field__label" for={id}>{label}</label>
  <input
    class="filter-field__control"
    id={id}
    name={name}
    type={type}
    placeholder={placeholder}
    value={value}
    data-filter-key={filterKey}
    aria-invalid={error ? 'true' : undefined}
    aria-describedby={error ? errorId : undefined}
  />
  {
    error && (
      <p class="filter-field__error" id={errorId}>
        <span class="filter-field__error-prefix">REVISAR</span> {error}
      </p>
    )
  }
</div>

<style>
  .filter-field__label {
    display: block;
    margin-bottom: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-label-sm);
    font-weight: 500;
    line-height: var(--leading-label-sm);
    letter-spacing: var(--tracking-label-sm);
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .filter-field__control {
    display: block;
    width: 100%;
    height: 44px;
    padding-inline: var(--space-3);
    border: 1px solid var(--color-border-interactive);
    border-radius: var(--radius-sm);
    background-color: var(--color-bg-surface);
    font-family: var(--font-sans);
    font-size: var(--text-body-md);
    line-height: var(--leading-body-md);
    color: var(--color-text-primary);
  }

  .filter-field__control::placeholder {
    color: var(--color-text-secondary);
    opacity: 1;
  }

  /* §6:308 — invalid: forest-ink border, never red. */
  .filter-field__control[aria-invalid='true'] {
    border-color: var(--color-text-primary);
  }

  .filter-field__error {
    margin: var(--space-2) 0 0;
    font-size: var(--text-body-sm);
    line-height: var(--leading-body-sm);
    color: var(--color-text-primary);
  }

  .filter-field__error-prefix {
    font-family: var(--font-mono);
    font-size: var(--text-label-sm);
    font-weight: 500;
    line-height: var(--leading-label-sm);
    letter-spacing: var(--tracking-label-sm);
    text-transform: uppercase;
  }
</style>
