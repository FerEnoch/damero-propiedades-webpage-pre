---
/**
 * Button — docs/DESIGN.md §6.
 *
 * The component never decides "primary-ness": the consumer passes the variant.
 * It renders an `<a>` when given an `href`, otherwise `<button type="button">`.
 */
type Variant = 'primary' | 'secondary' | 'ghost' | 'text-link';

interface Props {
  variant?: Variant;
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  target?: string;
  rel?: string;
  ariaLabel?: string;
  class?: string;
}

const {
  variant = 'primary',
  href,
  type = 'button',
  disabled = false,
  target,
  rel,
  ariaLabel,
  class: className,
} = Astro.props;

const isLink = typeof href === 'string';
const classes = ['button', `button--${variant}`, { 'is-disabled': disabled }, className];
---

{
  isLink ? (
    <a
      class:list={classes}
      href={disabled ? undefined : href}
      target={target}
      rel={rel}
      aria-label={ariaLabel}
      aria-disabled={disabled ? 'true' : undefined}
      tabindex={disabled ? -1 : undefined}
    >
      <slot />
    </a>
  ) : (
    <button
      class:list={classes}
      type={type}
      disabled={disabled}
      aria-label={ariaLabel}
    >
      <slot />
    </button>
  )
}

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding-inline: var(--space-6);
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.004em;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    -webkit-user-select: none;
    user-select: none;
  }

  .button--primary {
    background-color: var(--color-action-primary);
    color: var(--color-text-on-inverse);
  }

  .button--primary:hover {
    background-color: var(--color-forest-ink-hover);
  }

  .button--secondary {
    background-color: transparent;
    border-color: var(--color-border-interactive);
    color: var(--color-text-primary);
  }

  .button--secondary:hover {
    background-color: var(--color-bg-subtle);
  }

  .button--ghost {
    background-color: transparent;
    color: var(--color-text-accent);
  }

  .button--ghost:hover {
    background-color: var(--color-bg-subtle);
  }

  /*
   * Text link: the §6 "Text link" block specifies the underline treatment, not
   * the button box. It keeps a 44px touch target but drops the 24px inline
   * padding that would misalign it inside a heading row.
   */
  .button--text-link {
    min-height: 44px;
    padding-inline: 0;
    background-color: transparent;
    color: var(--color-text-accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    text-decoration-color: color-mix(in srgb, var(--color-text-accent) 40%, transparent);
  }

  .button--text-link:hover {
    text-decoration-color: var(--color-text-accent);
  }

  /* Disabled is a neutral surface, never a faded primary fill (§6). */
  .button.is-disabled,
  .button:disabled {
    background-color: var(--color-bg-subtle);
    border-color: transparent;
    color: color-mix(in srgb, var(--color-muted-text) 60%, transparent);
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
  }

  @media (min-width: 768px) {
    .button {
      min-height: 52px;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .button {
      transition:
        background-color var(--duration-state) var(--ease-out-expo),
        border-color var(--duration-state) var(--ease-out-expo),
        transform var(--duration-state) var(--ease-out-expo),
        box-shadow var(--duration-state) var(--ease-out-expo);
    }

    .button--primary:not(.is-disabled):not(:disabled):hover {
      transform: translateY(-1px);
      box-shadow: var(--shadow-sm);
    }

    .button--primary:not(.is-disabled):not(:disabled):active {
      transform: translateY(0);
      box-shadow: none;
    }
  }
</style>
