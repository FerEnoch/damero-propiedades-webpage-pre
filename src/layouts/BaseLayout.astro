---
import { Font } from 'astro:assets';
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Damero Propiedades' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <Font cssVariable="--font-newsreader" />
    <Font cssVariable="--font-hanken-grotesk" />
    <Font cssVariable="--font-jetbrains-mono" />
  </head>
  <body>
    <slot />
  </body>
</html>
