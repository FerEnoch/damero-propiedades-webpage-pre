# ─── LOCKFILE ESTRICTO ─────────────────────────────────────────────
# En CI/CD: instalar SIEMPRE con `pnpm install --frozen-lockfile`.
# Este setting hace lo mismo localmente: si el lockfile no satisface
# package.json, la instalación falla. Reproducibilidad garantizada.
prefer-frozen-lockfile=true

# ─── PEER DEPENDENCIES ─────────────────────────────────────────────
# Los peer dependencies faltantes son ERROR, no warning.
# (default de pnpm 10+; se explicita como política.)
strict-peer-dependencies=true

# No auto-instalar peers faltantes: deben declararse explícitamente.
# Con strict=true, un peer faltante falla la instalación.
auto-install-peers=false

# ─── ENGINE ────────────────────────────────────────────────────────
# Convierte `engines` de package.json en restricción dura:
# node/pnpm fuera de rango = error de instalación.
engine-strict=true

# ─── BUILD SCRIPTS ─────────────────────────────────────────────────
# El ~/.npmrc GLOBAL tiene `ignore-scripts=true`. Ese setting saltea TODOS
# los scripts de instalación en silencio y neutraliza el gate
# `strictDepBuilds: true` + `allowBuilds` de pnpm-workspace.yaml: la
# allowlist deny-by-default existe pero nunca llega a evaluarse.
# Se desactiva acá, a nivel proyecto, para que gobierne la allowlist:
# un paquete con scripts sin aprobar FALLA el install en vez de omitirse
# sin aviso (que es cómo se rompen esbuild/sharp sin causa aparente).
# No se modifica la configuración global: el alcance es este repo.
ignore-scripts=false
